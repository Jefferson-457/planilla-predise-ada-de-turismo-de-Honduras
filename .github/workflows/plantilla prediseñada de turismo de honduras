/* ---------- LIGHTBOX ---------- */
#lightbox{position:fixed;inset:0;z-index:99995;background:rgba(7,26,18,.94);backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;flex-direction:column;gap:22px;padding:5vh 5vw}
