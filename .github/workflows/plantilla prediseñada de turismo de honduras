.tarjeta-lugar:hover{transform:translateY(-14px);box-shadow:0 35px 70px rgba(29,36,32,.22)}
.foto-lugar{position:relative;height:270px;overflow:hidden;cursor:zoom-in}
.foto-lugar img{width:100%;height:100%;object-fit:cover;transition:transform 1.3s var(--ease-lujo)}
.tarjeta-lugar:hover .foto-lugar img{transform:scale(1.1)}
.foto-lugar .lupa{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(7,26,18,.4);opacity:0;transition:opacity .45s;color:var(--oro-claro);font-size:1.6rem}
