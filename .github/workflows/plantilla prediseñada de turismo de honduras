          <figcaption>Promoción que vuela alto</figcaption>
        </figure>
      </div>

      <input type="file" id="inputFotoColegio" accept="image/*" hidden>

      <p class="nota-fotos" data-anim><b>Personaliza esta galería para siempre:</b> pulsa <code>Cambiar imagen</code> en cada marco y elige una foto real del colegio (de tu galería o descargada de Facebook). La foto se optimiza sola y queda <b>guardada permanentemente en este navegador</b>. Para que <b>todas las personas</b> que abran la página vean esas mismas fotos, pulsa <code>Descargar página con mis fotos</code>: se genera un archivo HTML nuevo con tus imágenes incrustadas dentro del código para siempre — ese es el archivo que publicas o compartes.</p>

      <div class="gestion-fotos" data-anim>
        <button class="btn-mini" onclick="descargarPaginaConFotos()"><i class="fas fa-download"></i> Descargar página con mis fotos</button>
        <button class="btn-mini" onclick="restaurarIlustraciones()"><i class="fas fa-rotate-left"></i> Restaurar ilustraciones</button>
      </div>

      <div class="botones-centro" data-anim>
        <a class="btn-oro" href="https://www.facebook.com/p/Instituto-Gubernamental-Popol-Vuh-61565223736616/" target="_blank" rel="noopener"><i class="fab fa-facebook-f"></i> Fotos oficiales en Facebook</a>
        <a class="btn-fantasma oscuro" href="https://www.instagram.com/p/DUZo95cEuad/" target="_blank" rel="noopener"><i class="fab fa-instagram"></i> Instagram del instituto</a>
      </div>

      <!-- MENSAJE AL FUTURO -->
      <div class="cabecera-seccion" data-anim style="margin-top:100px;margin-bottom:0">
        <span class="kicker">Mirando al mañana</span>
        <h2>Que el próximo año <em>se multiplique el talento</em></h2>
        <p>Esperamos que el año que viene lleguen al Popol Vuh más estudiantes con mejores habilidades en el mundo de las redes, la programación y la inteligencia artificial. Porque el futuro no se espera: se programa. ¡Demuestra tus habilidades en el mejor colegio de todo Santa Cruz de Yojoa!</p>
      </div>
      <div class="pilares">
        <div class="pilar" data-anim style="--d:.05s"><i class="fas fa-network-wired"></i><h3>Redes</h3><p>Conectividad y comunicación digital para compartir el talento catracho con el mundo entero.</p></div>
        <div class="pilar" data-anim style="--d:.15s"><i class="fas fa-code"></i><h3>Programación</h3><p>Código, lógica y creatividad: esta página es la prueba de lo que se logra practicando en el aula.</p></div>
        <div class="pilar" data-anim style="--d:.25s"><i class="fas fa-robot"></i><h3>Inteligencia Artificial</h3><p>La nueva frontera: estudiantes que aprenden con IA y crean con IA para resolver problemas reales.</p></div>
      </div>
    </div>
  </div>
</div>

<!-- LIGHTBOX -->
<div id="lightbox">
  <button class="cerrar" onclick="cerrarLightbox()"><i class="fas fa-xmark"></i></button>
  <img id="lightbox-img" src="" alt="Fotografía ampliada">
  <div class="pie" id="lightbox-pie">Honduras Mágica</div>
</div>

<script>
/* ============ PRELOADER (a prueba de exportaciones) ============ */
(function(){
  const pre=document.getElementById('preloader');
  if(!pre){document.body.classList.add('cargado');return;}
  const fill=document.getElementById('pre-fill'),num=document.getElementById('pre-num');
  let p=0;const t=setInterval(()=>{p=Math.min(100,p+Math.random()*14+4);fill.style.transform=`scaleX(${p/100})`;num.textContent=Math.floor(p)+'%';
    if(p>=100){clearInterval(t);setTimeout(()=>{pre.classList.add('adios');document.body.classList.add('cargado');setTimeout(()=>pre.remove(),1400);},350);}},110);
})();

/* ============ CURSOR ============ */
const dot=document.querySelector('.cursor-dot'),ring=document.querySelector('.cursor-ring');
let mx=innerWidth/2,my=innerHeight/2,rx=mx,ry=my;
addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;dot.style.left=mx+'px';dot.style.top=my+'px';});
(function loop(){rx+=(mx-rx)*.14;ry+=(my-ry)*.14;ring.style.left=rx+'px';ring.style.top=ry+'px';requestAnimationFrame(loop);})();
document.addEventListener('mouseover',e=>{if(e.target.closest('a,button,.tarjeta-macro,.zoomable,.zoomable-svg,.marco-foto,.logo'))document.body.classList.add('cursor-grow');});
document.addEventListener('mouseout',e=>{if(e.target.closest('a,button,.tarjeta-macro,.zoomable,.zoomable-svg,.marco-foto,.logo'))document.body.classList.remove('cursor-grow');});

/* ============ PARTÍCULAS ============ */
(function(){const c=document.getElementById('particulas');if(!c)return;for(let i=0;i<26;i++){const s=document.createElement('span');s.className='particula';const sz=Math.random()*5+2;s.style.width=s.style.height=sz+'px';s.style.left=Math.random()*100+'vw';s.style.animationDuration=(Math.random()*10+9)+'s';s.style.animationDelay=(Math.random()*12)+'s';c.appendChild(s);}})();

/* ============ SCROLL ============ */
const nav=document.getElementById('nav'),prog=document.getElementById('progreso'),parallaxEls=document.querySelectorAll('[data-parallax]');
function onScroll(){const y=scrollY;prog.style.width=(y/(document.body.scrollHeight-innerHeight)*100)+'%';nav.classList.toggle('solido',y>60);
  parallaxEls.forEach(el=>{el.style.transform=`translateY(${y*parseFloat(el.dataset.parallax)}px)`;});}
addEventListener('scroll',()=>requestAnimationFrame(onScroll),{passive:true});onScroll();

/* ============ REVELADO ============ */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.15});
document.querySelectorAll('[data-anim]').forEach(el=>io.observe(el));

/* ============ CONTADORES ============ */
const ioNum=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;ioNum.unobserve(e.target);const meta=+e.target.dataset.meta,t0=performance.now();
  (function step(t){const k=Math.min(1,(t-t0)/1800),ease=1-Math.pow(1-k,4);e.target.textContent=Math.round(meta*ease);if(k<1)requestAnimationFrame(step);})(t0);}),{threshold:.6});
document.querySelectorAll('.contador').forEach(el=>ioNum.observe(el));

/* ============ TILT 3D ============ */
document.querySelectorAll('.tilt').forEach(card=>{
  card.addEventListener('mousemove',e=>{const r=card.getBoundingClientRect(),px=(e.clientX-r.left)/r.width,py=(e.clientY-r.top)/r.height;
    card.style.setProperty('--rx',((py-.5)*-8)+'deg');card.style.setProperty('--ry',((px-.5)*8)+'deg');
    card.style.setProperty('--mx',(px*100)+'%');card.style.setProperty('--my',(py*100)+'%');});
  card.addEventListener('mouseleave',()=>{card.style.setProperty('--rx','0deg');card.style.setProperty('--ry','0deg');});
});

/* ============ MAGNÉTICOS ============ */
document.querySelectorAll('.magnetico').forEach(b=>{b.addEventListener('mousemove',e=>{const r=b.getBoundingClientRect();b.style.transform=`translate(${(e.clientX-r.left-r.width/2)*.18}px,${(e.clientY-r.top-r.height/2)*.3-4}px)`;});b.addEventListener('mouseleave',()=>b.style.transform='');});

/* ============ NAVEGACIÓN ENTRE VISTAS ============ */
const curtain=document.getElementById('curtain'),vistaP=document.getElementById('vista-principal'),vistaI=document.getElementById('vista-interna'),btnVolver=document.getElementById('btnVolver');
let ocupado=false,zonaAbierta=false;
function transicion(accion){if(ocupado)return;ocupado=true;curtain.classList.add('cover-in');
  setTimeout(()=>{accion();scrollTo({top:0,behavior:'instant'});curtain.classList.remove('cover-in');curtain.classList.add('cover-out');
    setTimeout(()=>{curtain.classList.add('no-trans');curtain.classList.remove('cover-out');void curtain.offsetWidth;curtain.classList.remove('no-trans');ocupado=false;},700);},700);}
function abrirZona(id){transicion(()=>{vistaP.style.display='none';vistaI.style.display='block';
  document.querySelectorAll('.zona-oculta').forEach(z=>z.classList.remove('activa'));
  document.getElementById('zona-'+id).classList.add('activa');
  btnVolver.classList.add('visible');zonaAbierta=true;
  document.querySelectorAll('#zona-'+id+' [data-anim]').forEach(el=>{el.classList.remove('in');io.observe(el);});});}
function volverAlInicio(){if(!zonaAbierta){scrollTo({top:0,behavior:'smooth'});return;}transicion(()=>{vistaI.style.display='none';document.querySelectorAll('.zona-oculta').forEach(z=>z.classList.remove('activa'));vistaP.style.display='block';btnVolver.classList.remove('visible');zonaAbierta=false;});}
function irA(seccion){if(zonaAbierta){volverAlInicio();setTimeout(()=>document.getElementById(seccion)?.scrollIntoView({behavior:'smooth'}),1500);}else{document.getElementById(seccion)?.scrollIntoView({behavior:'smooth'});}}

/* ============ LIGHTBOX ============ */
const lb=document.getElementById('lightbox'),lbImg=document.getElementById('lightbox-img'),lbPie=document.getElementById('lightbox-pie');
document.querySelectorAll('.zoomable').forEach(f=>f.addEventListener('click',e=>{e.stopPropagation();const img=f.querySelector('img');lbImg.src=img.src;lbPie.textContent=img.alt;lb.classList.add('abierto');document.body.classList.add('bloqueado');}));
function cerrarLightbox(){lb.classList.remove('abierto');document.body.classList.remove('bloqueado');}
lb.addEventListener('click',e=>{if(e.target===lb)cerrarLightbox();});
addEventListener('keydown',e=>{if(e.key==='Escape')cerrarLightbox();});

/* Lightbox: fotos reales del colegio o ilustraciones SVG */
document.querySelectorAll('.zoomable-svg').forEach(f=>f.addEventListener('click',()=>{
  const real=f.classList.contains('con-foto')?f.querySelector('img.foto-real'):null;
  if(real){lbImg.src=real.src;lbPie.textContent=real.alt||'Foto del Instituto Popol Vuh';}
  else{const svg=f.querySelector('svg');if(!svg)return;
    lbImg.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(new XMLSerializer().serializeToString(svg));
    lbPie.textContent=(f.querySelector('figcaption')?.textContent||'Honduras Mágica').trim();}
  lb.classList.add('abierto');document.body.classList.add('bloqueado');
}));

/* ============ FOTOS PERSONALIZADAS PERMANENTES DEL COLEGIO ============ */
const marcosColegio=[...document.querySelectorAll('.marco-foto')];
const inputFoto=document.getElementById('inputFotoColegio');
let indFotoActual=0;

function elegirFoto(i,ev){ev.stopPropagation();indFotoActual=i;inputFoto.click();}

/* Reduce y comprime la imagen (máx. 1400px, JPG 85%) para que quepa
   en el almacenamiento del navegador y el archivo exportado no pese mucho */
function procesarImagen(file,cb){
  const r=new FileReader();
  r.onload=()=>{const img=new Image();
    img.onload=()=>{const MAX=1400;const s=Math.min(1,MAX/Math.max(img.width,img.height));
      const w=Math.round(img.width*s),h=Math.round(img.height*s);
      const cv=document.createElement('canvas');cv.width=w;cv.height=h;
      cv.getContext('2d').drawImage(img,0,0,w,h);
      cb(cv.toDataURL('image/jpeg',.85));};
    img.src=r.result;};
  r.readAsDataURL(file);
}

inputFoto.addEventListener('change',()=>{
  const f=inputFoto.files[0];if(!f)return;
  procesarImagen(f,data=>{
    ponerFoto(indFotoActual,data);
    try{localStorage.setItem('hm_foto_colegio_'+indFotoActual,data);}
    catch(e){alert('No se pudo guardar en este navegador (memoria llena), pero la foto sí aparecerá al descargar la página.');}
  });
  inputFoto.value='';
});

function ponerFoto(i,dataURL){
  const m=marcosColegio[i];if(!m)return;
  m.classList.add('con-foto');
  let img=m.querySelector('img.foto-real');
  if(!img){img=document.createElement('img');img.className='foto-real';m.insertBefore(img,m.querySelector('svg'));}
  img.src=dataURL;
  img.alt=(m.querySelector('figcaption')?.textContent||'Foto del Instituto Popol Vuh')+' — foto real';
}

/* Al abrir la página, restaura tus fotos guardadas */
(function cargarFotosGuardadas(){
  marcosColegio.forEach((m,i)=>{
    try{const d=localStorage.getItem('hm_foto_colegio_'+i);if(d)ponerFoto(i,d);}catch(e){}
  });
})();

function restaurarIlustraciones(){
  if(!confirm('¿Quitar tus fotos y volver a las ilustraciones originales?'))return;
  marcosColegio.forEach((m,i)=>{
    m.classList.remove('con-foto');
    const img=m.querySelector('img.foto-real');if(img)img.remove();
    try{localStorage.removeItem('hm_foto_colegio_'+i);}catch(e){}
  });
}

/* Genera un archivo HTML NUEVO con tus fotos incrustadas en el código:
   ese archivo es el que publicas o compartes, y todos verán tus fotos */
function descargarPaginaConFotos(){
  const clon=document.documentElement.cloneNode(true);
  clon.querySelectorAll('[data-anim]').forEach(el=>el.classList.remove('in'));
  const b=clon.querySelector('body');if(b)b.className='';
  const c=clon.querySelector('#curtain');if(c)c.className='';
  const n=clon.querySelector('#nav');if(n)n.className='';
  const bv=clon.querySelector('#btnVolver');if(bv)bv.classList.remove('visible');
  const vp=clon.querySelector('#vista-principal');if(vp)vp.removeAttribute('style');
  const vi=clon.querySelector('#vista-interna');if(vi)vi.removeAttribute('style');
  clon.querySelectorAll('.zona-oculta').forEach(z=>z.classList.remove('activa'));
  clon.querySelectorAll('[data-parallax]').forEach(el=>el.style.removeProperty('transform'));
  clon.querySelectorAll('.tilt').forEach(el=>{el.style.removeProperty('--rx');el.style.removeProperty('--ry');});
  const part=clon.querySelector('#particulas');if(part)part.innerHTML='';
  const pr=clon.querySelector('#progreso');if(pr)pr.style.width='0';
  const lbx=clon.querySelector('#lightbox');if(lbx)lbx.classList.remove('abierto');
  const html='<!DOCTYPE html>\n'+clon.outerHTML;
  const blob=new Blob([html],{type:'text/html'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='honduras-magica-con-mis-fotos.html';
  document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href),4000);
}
</script>
</body>
</html>
