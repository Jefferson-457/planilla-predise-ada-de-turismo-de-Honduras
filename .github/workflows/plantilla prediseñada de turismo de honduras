.info-lugar{padding:32px 30px 36px}
.info-lugar h3{color:var(--jungla);font-size:1.55rem;margin-bottom:14px;line-height:1.25}
.info-lugar h3::after{content:'';display:block;width:44px;height:2px;background:var(--oro);margin-top:14px;transition:width .5s var(--ease-lujo)}
.tarjeta-lugar:hover .info-lugar h3::after{width:90px}
.info-lugar p{color:#5d6560;line-height:1.8;font-size:.96rem;font-weight:300}
.meta-lugar{display:flex;gap:20px;margin-top:20px;padding-top:18px;border-top:1px dashed rgba(29,36,32,.18);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--oro);font-weight:700;flex-wrap:wrap}
.meta-lugar i{margin-right:7px}

/* ---------- BOTÓN VOLVER ---------- */
.btn-volver{position:fixed;bottom:36px;right:36px;z-index:9980;background:var(--jungla);color:var(--oro-claro);border:1px solid rgba(201,162,75,.6);padding:16px 30px;border-radius:50px;font-family:'Manrope';font-size:.8rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;cursor:pointer;display:none;align-items:center;gap:12px;box-shadow:0 18px 45px rgba(0,0,0,.4);transition:all .4s var(--ease-lujo)}
